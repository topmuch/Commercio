# ============================================================
# Teranga Biz — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit your .env file to version control.

# ─── DATABASE ───────────────────────────────────────────────
# SQLite (default — file-based, no external DB needed)
DATABASE_URL=file:./db/custom.db

# PostgreSQL (for production multi-tenant SaaS)
# DATABASE_URL=postgresql://user:password@localhost:5432/terangabiz

# ─── AUTHENTICATION (Required for production) ──────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-key-here

# Base URL of your application (required for email links, callbacks)
NEXTAUTH_URL=http://localhost:3000

# ─── AI ASSISTANT ─────────────────────────────────────────
# API key for the LLM-powered AI assistant
Z_AI_API_KEY=your-z-ai-api-key-here

# ─── OPTIONAL: SMTP (Email) ───────────────────────────────
# If not set, email features will be disabled
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASS=your-email-password
# EMAIL_FROM=noreply@yourdomain.com
