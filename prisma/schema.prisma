generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ===== COMPANIES (Multi-tenant) =====
model Company {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?
  address   String?
  logo      String?
  plan      String   @default("free") // free, pro, enterprise
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  clients   Client[]
  products  Product[]
  categories Category[]
  orders    Order[]
  quotes    Quote[]
  invoices  Invoice[]
  stockMovements StockMovement[]
  visits    Visit[]
  discussions Discussion[]
  payments  Payment[]
}

// ===== USERS =====
model User {
  id        String   @id @default(cuid())
  email     String
  password  String
  name      String
  phone     String?
  avatar    String?
  role      String   @default("commercial") // super_admin, admin, director, commercial, accountant
  active    Boolean  @default(true)
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company     Company  @relation(fields: [companyId], references: [id])
  orders      Order[]
  quotes      Quote[]
  invoices    Invoice[]
  visits      Visit[]
  discussions Discussion[]
  clients     Client[]

  targets     Target[]
}

// ===== CLIENTS =====
model Client {
  id           String   @id @default(cuid())
  companyName  String
  contactName  String
  phone        String
  whatsapp     String?
  email        String?
  address      String?
  city         String?
  region       String?
  latitude     Float?
  longitude    Float?
  sector       String?
  type         String   @default("boutique") // boutique, revendeur, supermarche, grossiste
  status       String   @default("active") // active, inactive, prospect
  notes        String?
  commercialId String?
  companyId    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company      Company  @relation(fields: [companyId], references: [id])
  commercial   User?    @relation(fields: [commercialId], references: [id])
  orders       Order[]
  quotes       Quote[]
  invoices     Invoice[]
  visits       Visit[]
  discussions  Discussion[]
  payments     Payment[]
}

// ===== CATEGORIES =====
model Category {
  id        String     @id @default(cuid())
  name      String
  parentId  String?
  image     String?
  companyId String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  company   Company    @relation(fields: [companyId], references: [id])
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  products  Product[]
}

// ===== PRODUCTS =====
model Product {
  id           String   @id @default(cuid())
  name         String
  reference    String   @unique
  description  String?
  price        Float
  resellerPrice Float?
  image        String?
  categoryId   String?
  brand        String?
  stock        Int      @default(0)
  minStock     Int      @default(5)
  status       String   @default("active") // active, inactive, archived
  companyId    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company      Company    @relation(fields: [companyId], references: [id])
  category     Category?  @relation(fields: [categoryId], references: [id])
  orderItems   OrderItem[]
  quoteItems   QuoteItem[]
  invoiceItems InvoiceItem[]
  stockMovements StockMovement[]
}

// ===== ORDERS =====
model Order {
  id          String   @id @default(cuid())
  number      String   @unique
  status      String   @default("new") // new, validated, preparation, shipped, delivered
  total       Float    @default(0)
  discount    Float    @default(0)
  tax         Float    @default(0)
  notes       String?
  clientId    String
  commercialId String?
  companyId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company  @relation(fields: [companyId], references: [id])
  client      Client   @relation(fields: [clientId], references: [id])
  commercial  User?    @relation(fields: [commercialId], references: [id])
  items       OrderItem[]
}

// ===== ORDER ITEMS =====
model OrderItem {
  id         String  @id @default(cuid())
  productId  String
  orderId    String
  quantity   Int
  unitPrice  Float
  totalPrice Float

  product    Product @relation(fields: [productId], references: [id])
  order      Order   @relation(fields: [orderId], references: [id])
}

// ===== QUOTES =====
model Quote {
  id          String   @id @default(cuid())
  number      String   @unique
  status      String   @default("draft") // draft, sent, accepted, refused
  total       Float    @default(0)
  discount    Float    @default(0)
  tax         Float    @default(0)
  validUntil  DateTime?
  notes       String?
  clientId    String
  commercialId String?
  companyId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company  @relation(fields: [companyId], references: [id])
  client      Client   @relation(fields: [clientId], references: [id])
  commercial  User?    @relation(fields: [commercialId], references: [id])
  items       QuoteItem[]
}

// ===== QUOTE ITEMS =====
model QuoteItem {
  id         String  @id @default(cuid())
  productId  String
  quoteId    String
  quantity   Int
  unitPrice  Float
  totalPrice Float

  product    Product @relation(fields: [productId], references: [id])
  quote      Quote   @relation(fields: [quoteId], references: [id])
}

// ===== INVOICES =====
model Invoice {
  id          String   @id @default(cuid())
  number      String   @unique
  status      String   @default("unpaid") // paid, partially_paid, unpaid, overdue
  total       Float    @default(0)
  paid        Float    @default(0)
  discount    Float    @default(0)
  tax         Float    @default(0)
  dueDate     DateTime?
  notes       String?
  orderId     String?
  clientId    String
  commercialId String?
  companyId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company  @relation(fields: [companyId], references: [id])
  client      Client   @relation(fields: [clientId], references: [id])
  commercial  User?    @relation(fields: [commercialId], references: [id])
  items       InvoiceItem[]
  payments    Payment[]
}

// ===== INVOICE ITEMS =====
model InvoiceItem {
  id         String  @id @default(cuid())
  productId  String
  invoiceId  String
  quantity   Int
  unitPrice  Float
  totalPrice Float

  product    Product @relation(fields: [productId], references: [id])
  invoice    Invoice @relation(fields: [invoiceId], references: [id])
}

// ===== PAYMENTS =====
model Payment {
  id          String   @id @default(cuid())
  amount      Float
  method      String   @default("cash") // cash, bank_transfer, check, mobile_payment
  reference   String?
  status      String   @default("completed") // pending, completed, failed
  notes       String?
  invoiceId   String?
  clientId    String
  companyId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invoice     Invoice? @relation(fields: [invoiceId], references: [id])
  company     Company  @relation(fields: [companyId], references: [id])
  client      Client   @relation(fields: [clientId], references: [id])
}

// ===== STOCK MOVEMENTS =====
model StockMovement {
  id         String   @id @default(cuid())
  type       String   // entry, exit, adjustment, inventory
  quantity   Int
  reason     String?
  productId  String
  companyId  String
  createdAt  DateTime @default(now())

  company    Company  @relation(fields: [companyId], references: [id])
  product    Product  @relation(fields: [productId], references: [id])
}

// ===== VISITS =====
model Visit {
  id          String   @id @default(cuid())
  type        String   @default("visit") // visit, call, note
  notes       String?
  status      String   @default("completed") // planned, completed, cancelled
  latitude    Float?
  longitude   Float?
  clientId    String
  commercialId String
  companyId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company  @relation(fields: [companyId], references: [id])
  client      Client   @relation(fields: [clientId], references: [id])
  commercial  User     @relation(fields: [commercialId], references: [id])
}

// ===== DISCUSSIONS =====
model Discussion {
  id          String   @id @default(cuid())
  type        String   @default("message") // message, call, note, whatsapp
  content     String
  direction   String   @default("outgoing") // incoming, outgoing
  clientId    String
  commercialId String?
  companyId   String
  createdAt   DateTime @default(now())

  company     Company  @relation(fields: [companyId], references: [id])
  client      Client   @relation(fields: [clientId], references: [id])
  commercial  User?    @relation(fields: [commercialId], references: [id])
}

// ===== TARGETS =====
model Target {
  id          String   @id @default(cuid())
  type        String   @default("revenue") // revenue, clients, visits
  value       Float
  period      String   @default("monthly") // weekly, monthly, quarterly, yearly
  startDate   DateTime
  endDate     DateTime
  achieved    Float    @default(0)
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id])
}
